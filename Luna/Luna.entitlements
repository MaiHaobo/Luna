<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Luna reserves 128 Keychain access groups so each guest can be pinned to
	  its own compartment. KeychainGroupAllocator assigns the index
	  deterministically from the guest's bundle identifier; the two must stay
	  in sync, so change one and you must change the other.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)luna.guest.0</string>
